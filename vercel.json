{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/embed/heatmap",
      "destination": "/embed/heatmap.html"
    },
    {
      "source": "/embed/reports", 
      "destination": "/embed/reports.html"
    },
    {
      "source": "/:path(.+)",
      "destination": "/:path.html"
    }
  ]
}















